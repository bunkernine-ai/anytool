{
  "name": "anytool",
  "version": "0.1.0",
  "description": "Bounded capability runtime for AI agents: strong intent, RFC policy, isolated code, core drivers.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rfc/schemas/policy.schema.json": "./rfc/schemas/policy.schema.json",
    "./rfc/schemas/intent.schema.json": "./rfc/schemas/intent.schema.json",
    "./rfc/schemas/ast.schema.json": "./rfc/schemas/ast.schema.json"
  },
  "files": [
    "dist",
    "rfc"
  ],
  "scripts": {
    "codegen": "node scripts/codegen.mjs",
    "build": "npm run codegen && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agent",
    "ai",
    "sandbox",
    "policy",
    "drivers"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@langchain/core": "^0.3.0 || ^1.0.0",
    "ai": "^4.0.0 || ^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    }
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
